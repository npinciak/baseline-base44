{
  "name": "SubscriptionEntitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_reference": {
      "type": "string",
      "description": "Verified billing reference; only trusted administrators or billing handlers may assign access."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "status",
    "expires_at",
    "provider_reference"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}