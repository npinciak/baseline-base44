{
  "name": "UserStats",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "current_level": {
      "type": "number",
      "default": 1
    },
    "current_streak": {
      "type": "number",
      "default": 0
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    },
    "streak_shield_active": {
      "type": "boolean",
      "default": false,
      "description": "True when a 1-day Streak Shield (Level 2 benefit) is armed to protect a single missed day."
    },
    "last_activity_date": {
      "type": "string",
      "format": "date"
    },
    "financial_goal": {
      "type": "string",
      "enum": [
        "save_money",
        "get_out_of_debt",
        "invest",
        "build_credit",
        "understand_basics"
      ]
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "complete_beginner",
        "some_knowledge",
        "intermediate"
      ]
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "first_goal_workflow_completed": {
      "type": "boolean",
      "default": false
    },
    "base_score": {
      "type": "number",
      "description": "Overall BaseScore out of 500"
    },
    "score_financial_knowledge": {
      "type": "number",
      "description": "Financial Knowledge category score out of 100"
    },
    "score_income_debt": {
      "type": "number",
      "description": "Income to Debt Ratio category score out of 100"
    },
    "score_preparedness": {
      "type": "number",
      "description": "Preparedness category score out of 100"
    },
    "score_risk_appetite": {
      "type": "number",
      "description": "Risk Appetite category score out of 100"
    },
    "score_credit_health": {
      "type": "number",
      "description": "Credit Health category score out of 100"
    }
  },
  "required": [
    "user_id"
  ]
}