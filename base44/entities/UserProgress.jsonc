{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "score": {
      "type": "number"
    },
    "xp_earned": {
      "type": "number",
      "default": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "lesson_id",
    "module_id"
  ]
}