{
  "name": "BankConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "plaid",
        "mx"
      ]
    },
    "institution_name": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "account_type": {
      "type": "string"
    },
    "access_token_ref": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "provider"
  ]
}