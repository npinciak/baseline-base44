{
  "name": "SavingsGoal",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target_amount": {
      "type": "number"
    },
    "saved_amount": {
      "type": "number",
      "default": 0
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "name",
    "target_amount"
  ]
}