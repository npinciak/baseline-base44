{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "lesson_type": {
      "type": "string",
      "enum": [
        "text",
        "quiz",
        "flashcard"
      ]
    },
    "order_index": {
      "type": "number"
    },
    "xp_reward": {
      "type": "number",
      "default": 20
    },
    "is_published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "module_id",
    "title",
    "lesson_type"
  ]
}