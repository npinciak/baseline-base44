{
  "name": "GoalPlan",
  "type": "object",
  "properties": {
    "supabase_goal_id": {
      "type": "string",
      "description": "Savings goal this plan belongs to"
    },
    "contribution_amount": {
      "type": "number",
      "description": "Amount the user plans to set aside each period"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple"
      ],
      "default": "monthly"
    },
    "motivation": {
      "type": "string",
      "maxLength": 500,
      "description": "Why this goal matters to the user"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "supabase_goal_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}