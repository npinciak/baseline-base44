{
  "name": "ContactInquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "topic": {
      "type": "string",
      "enum": [
        "general",
        "students_families",
        "partnerships",
        "support"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow"
      ],
      "default": "general"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "replied",
        "closed"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "description"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}