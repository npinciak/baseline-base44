{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_scheduled_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "insert_heartbeat": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "insertHeartbeat",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Insert Heartbeat",
            "description": "Writes a row to public.heartbeat"
          }
        }
      }
    ]
  },
  "name": "Daily Scheduled Workflow",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Runs every day at midnight, inserting a row into public.heartbeat."
}